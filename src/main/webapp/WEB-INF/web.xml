<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
  
  <!-- エラーページの設定 -->
  <error-page>
    <error-code>404</error-code>
    <location>/error/404.html</location>
  </error-page>
  
  <error-page>
    <error-code>403</error-code>
    <location>/error/403.html</location>
  </error-page>
  
  <error-page>
    <error-code>500</error-code>
    <location>/error/500.html</location>
  </error-page>
  
  <!-- StudentManagementServlet のマッピング -->
  <servlet>
    <servlet-name>StudentManagementServlet</servlet-name>
    <servlet-class>servlet.StudentManagementServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>StudentManagementServlet</servlet-name>
    <url-pattern>/StudentManagementServlet</url-pattern>
  </servlet-mapping>
  
  <servlet>
    <servlet-name>StatusServlet</servlet-name>
    <servlet-class>servlet.StatusServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>StatusServlet</servlet-name>
    <url-pattern>/StatusServlet</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>StudentServlet</servlet-name>
    <servlet-class>servlet.StudentServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>StudentServlet</servlet-name>
    <url-pattern>/StudentServlet</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>servlet.LoginServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/LoginServlet</url-pattern>
  </servlet-mapping>
  
  <servlet>
    <servlet-name>RegisterServlet</servlet-name>
    <servlet-class>servlet.RegisterServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>RegisterServlet</servlet-name>
    <url-pattern>/RegisterServlet</url-pattern>
  </servlet-mapping>
  
  <servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>servlet.LogoutServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/LogoutServlet</url-pattern>
  </servlet-mapping>
  

  

  
  <!-- 企業管理サーブレット -->
  <servlet>
    <servlet-name>CompanyManagementServlet</servlet-name>
    <servlet-class>servlet.CompanyManagementServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>CompanyManagementServlet</servlet-name>
    <url-pattern>/CompanyManagementServlet</url-pattern>
  </servlet-mapping>
  
  <!-- 面接・試験入力サーブレット -->
  <servlet>
    <servlet-name>SelectionStageViewServlet</servlet-name>
    <servlet-class>servlet.SelectionStageViewServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>SelectionStageViewServlet</servlet-name>
    <url-pattern>/SelectionStageViewServlet</url-pattern>
  </servlet-mapping>
  
  <!-- 面接・試験表示サーブレット -->
  <servlet>
    <servlet-name>InterviewExamViewServlet</servlet-name>
    <servlet-class>servlet.InterviewExamViewServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>InterviewExamViewServlet</servlet-name>
    <url-pattern>/InterviewExamViewServlet</url-pattern>
  </servlet-mapping>
  
  <!-- 選考段階管理サーブレット -->
  <servlet>
    <servlet-name>SelectionStageServlet</servlet-name>
    <servlet-class>servlet.SelectionStageServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>SelectionStageServlet</servlet-name>
    <url-pattern>/SelectionStageServlet</url-pattern>
  </servlet-mapping>
  
  <!-- 学生登録サーブレット -->
  <servlet>
    <servlet-name>CreateStudentServlet</servlet-name>
    <servlet-class>servlet.CreateStudentServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>CreateStudentServlet</servlet-name>
    <url-pattern>/CreateStudentServlet</url-pattern>
  </servlet-mapping>
  
  <!-- ダッシュボードサーブレット -->
  <servlet>
    <servlet-name>DashboardServlet</servlet-name>
    <servlet-class>servlet.DashboardServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>DashboardServlet</servlet-name>
    <url-pattern>/DashboardServlet</url-pattern>
  </servlet-mapping>
  
  <!-- 企業詳細・編集サーブレット -->
  <servlet>
    <servlet-name>CompanyDetailServlet</servlet-name>
    <servlet-class>servlet.CompanyDetailServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>CompanyDetailServlet</servlet-name>
    <url-pattern>/CompanyDetailServlet</url-pattern>
  </servlet-mapping>
  
  <!-- 企業一覧サーブレット -->
  <servlet>
    <servlet-name>CompanyListServlet</servlet-name>
    <servlet-class>servlet.CompanyListServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>CompanyListServlet</servlet-name>
    <url-pattern>/CompanyListServlet</url-pattern>
  </servlet-mapping>
  
  <!-- 企業登録サーブレット -->
  <servlet>
    <servlet-name>CreateCompanyServlet</servlet-name>
    <servlet-class>servlet.CreateCompanyServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>CreateCompanyServlet</servlet-name>
    <url-pattern>/CreateCompanyServlet</url-pattern>
  </servlet-mapping>
  
  
  <!-- 学生詳細サーブレット -->
  <servlet>
    <servlet-name>StudentDetailServlet</servlet-name>
    <servlet-class>servlet.StudentDetailServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>StudentDetailServlet</servlet-name>
    <url-pattern>/StudentDetailServlet</url-pattern>
  </servlet-mapping>
  
  <!-- 学生表示サーブレット -->
  <servlet>
    <servlet-name>StudentViewServlet</servlet-name>
    <servlet-class>servlet.StudentViewServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>StudentViewServlet</servlet-name>
    <url-pattern>/StudentViewServlet</url-pattern>
  </servlet-mapping>
  
  <!-- 学生一覧サーブレット -->
  <servlet>
    <servlet-name>StudentListServlet</servlet-name>
    <servlet-class>servlet.StudentListServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>StudentListServlet</servlet-name>
    <url-pattern>/StudentListServlet</url-pattern>
  </servlet-mapping>
  
  <!-- データベース管理サーブレット -->
  <servlet>
    <servlet-name>DatabaseManagementServlet</servlet-name>
    <servlet-class>servlet.DatabaseManagementServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>DatabaseManagementServlet</servlet-name>
    <url-pattern>/DatabaseManagementServlet</url-pattern>
  </servlet-mapping>
  
  <!-- 就活情報検索サーブレット -->
  <servlet>
    <servlet-name>JobHuntingSearchServlet</servlet-name>
    <servlet-class>servlet.JobHuntingSearchServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>JobHuntingSearchServlet</servlet-name>
    <url-pattern>/JobHuntingSearchServlet</url-pattern>
  </servlet-mapping>
  
  <!-- バックアップディレクトリの設定 -->
  <context-param>
    <param-name>backup-directory</param-name>
    <param-value>/backups</param-value>
  </context-param>
  
</web-app>